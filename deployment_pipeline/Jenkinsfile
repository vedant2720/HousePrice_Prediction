pipeline {
    agent any
    
    environment {
        PYTHONIOENCODING = 'utf-8'
    }
    
    stages {
        stage('Install Dependencies') {
            steps {
                bat 'pip install uv'
                bat 'uv pip install --system -r deployment_pipeline/requirements.txt'
            }
        }
        stage('Download Latest Model from EC2') {
            steps {
                // CHANGE HERE: Move into the folder before running the script
                dir('deployment_pipeline') {
                    bat 'python download_model.py'
                }
            }
        }
        stage('Build & Deploy Container') {
            steps {
                dir('deployment_pipeline') {
                    bat 'docker build -t house-price-api:latest .'
                    bat 'docker rm -f house-price-api || exit 0'
                    bat 'docker run -d -p 8000:8000 --name house-price-api house-price-api:latest'
                }
            }
        }
    }
}