pipeline {
    agent any
    
    // Add this environment block to force UTF-8 encoding
    environment {
        PYTHONIOENCODING = 'utf-8'
    }
    
    stages {
        stage('Install Dependencies') {
            steps {
                bat 'pip install uv'
                bat 'uv pip install --system -r training_pipeline/requirements.txt'
            }
        }
        stage('Train & Register Model to EC2') {
            steps {
                bat 'python training_pipeline/train.py' 
            }
        }
    }
}